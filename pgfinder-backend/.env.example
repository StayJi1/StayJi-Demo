# Database Configuration
# MongoDB connection string - example format below
# DATABASE=mongodb+srv://username:password@cluster.mongodb.net/pgfinder?retryWrites=true&w=majority
DATABASE=your_mongodb_connection_string_here
#use the below connection string for local development,only updating theusername and password
#DATABASE=mongodb+srv://<Username>:<Password>@cluster0.b3s895e.mongodb.net/pgfinder?retryWrites=true&w=majority&appName=Cluster0

# Server Port
PORT=3000

# Session Secret
SESSION_SECRET=your-session-secret-key-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Google registration sync (optional locally, required for production launch)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_REGISTRATION_SHEET_ID=your-google-sheet-id
GOOGLE_REGISTRATION_SHEET_NAME=Registrations
GOOGLE_DRIVE_REGISTRATION_FOLDER_ID=your-google-drive-folder-id

# CORS Origins (for production, add your frontend URL)
# CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173
