# Frontend API Configuration
# Local development
# VITE_API_BASE_URL=http://localhost:3000

# Production - point to your Render backend URL
# VITE_API_BASE_URL=https://your-backend-name.onrender.com

VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Set to true only on the demonstration frontend deployment. This serves the
# fictional frontend-only inventory and leaves all owner/admin APIs untouched.
VITE_DEMO_PROPERTY_MODE=false
